# ============================================================
# Luminew AI 面試系統 - 環境變數設定檔範本
# 使用方式：將此檔案複製為 .env，並填入對應的 API Key
#   copy .env.example .env
# ============================================================

# === OpenAI（AI 面試對話引擎）===
OPENAI_API_KEY=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# === 雅婷 Yating（語音辨識 STT / 語音合成 TTS）===
YATING_API_KEY=
ASR_TOKEN_URL=https://asr.api.yating.tw/v1/token
ASR_WS_URL=wss://asr.api.yating.tw/ws/v1/?token=
YATING_TTS_URL=https://tts.api.yating.tw/v2/speeches/short

# === MiniMax（語音合成 備用方案）===
MINIMAX_API_KEY=
MINIMAX_WS_URL=wss://api.minimax.io/ws/v1/t2a_v2
MINIMAX_DEFAULT_VOICE=Chinese (Mandarin)_Male_Announcer

# === D-ID（數位人像面試官）===
D_ID_API_KEY=
D_ID_URL=https://api.d-id.com/talks/streams

# === Ngrok / Cloudflare Tunnel（對外通道）===
NGROK_AUTHTOKEN=
USE_NGROK=False
PUBLIC_URL=https://luminew.site

# === SMTP 信箱（系統寄信通知用，建議使用 Gmail 應用程式密碼）===
SMTP_EMAIL=
SMTP_PASSWORD=

# === 資料庫連線（MS SQL Server）===
DB_HOST=127.0.0.1
